<%- include("partials/header") %>

<h1>Archive</h1>

<div class="archive-list">
  <% if (posts.length === 0) { %>
    <p>No posts yet.</p>
  <% } %>

  <% posts.forEach(function(p) { %>
    <div class="post">
      <h3><%= p.title %></h3>
      <p><strong>Author:</strong> <%= p.author %></p>
      <p><%= p.content %></p>

      <% if (p.image) { %>
        <img src="<%= p.image %>" alt="Uploaded image" style="max-width: 200px;">
      <% } %>
    </div>
  <% }) %>
</div>

<%- include("partials/footer") %>